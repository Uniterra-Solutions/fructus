# fructus-server configuration (D11, REQ-B-1). Copy to `.env` (git-ignored) and edit.
# This file documents every key the server reads; defaults are shown inline.

# Solana RPC endpoint (HTTP). Devnet: https://api.devnet.solana.com — local: http://127.0.0.1:8899
RPC_URL=http://127.0.0.1:8899

# SQLite file backing the indexed state (`node:sqlite`, Node >= 22 builtin).
DATABASE_PATH=./fructus-server.sqlite

# HS256 secret for the session JWTs (REQ-B-4). REQUIRED — the server refuses to
# boot without it. Mint one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Operator keypair (JSON array file, `solana-keygen` format). Server-side only:
# never logged, separate from the program upgrade authority (R-3). Unset ⇒
# operator actions are unavailable.
OPERATOR_KEYPAIR=/path/to/operator.json

# HTTP listen port.
PORT=8787

# Keeper loop period, ms (REQ-B-6).
KEEPER_INTERVAL_MS=5000

# Faucet (D15, REQ-B-8): disabled — and answering 404 — unless FAUCET_ENABLED=1
# AND both FAUCET_MINT and FAUCET_MINT_AUTHORITY_KEYPAIR are configured.
FAUCET_ENABLED=0
FAUCET_MINT=
FAUCET_MINT_AUTHORITY_KEYPAIR=
# 24 h caps in raw microunits (USDC is 6 dp): per wallet / global.
FAUCET_PER_WALLET_CAP=10000000000
FAUCET_GLOBAL_CAP=1000000000000
# Per-request drip in raw microunits (USDC is 6 dp): each accepted call mints
# exactly one drip; the caps above calibrate against it.
FAUCET_DRIP=10000000
