{
  "name": "fructus-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fructus product-v2 backend service (D11): chain indexer, state layer, SIWS auth, operator relay, keeper, REST + WebSocket API.",
  "scripts": {
