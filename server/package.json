    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "fructus-sdk": "file:../sdk",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "^8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
