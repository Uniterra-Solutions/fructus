{
  "name": "fructus-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fructus devnet deploy + end-to-end lifecycle walk (issue #9). Run from this scripts/ directory.",
  "scripts": {
    "e2e": "tsx e2e.mts",
    "e2e:network": "RUN_E2E=1 tsx e2e.mts",
    "setup": "tsx selfcontained.mts",
    "setup:preflight": "tsx selfcontained.mts --preflight",
    "deploy": "bash deploy.sh",
    "mm": "tsx mm-bot.mts",
    "devstack": "tsx devstack.mts",
    "test": "tsx --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "fructus-sdk": "file:../sdk"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
